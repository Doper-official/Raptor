#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(set = 0, binding = 0) uniform sampler2D panorama;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2DArray cubemapImage;

const float PI = 3.14159265359;

void main() {
  ivec3 pixel = ivec3(gl_GlobalInvocationID);
  ivec3 dimensions = imageSize(cubemapImage);

  if (pixel.x >= dimensions.x || pixel.y >= dimensions.y || pixel.z >= 6) {
    return;
  }

  vec2 uv = (vec2(pixel.xy) + 0.5) / vec2(dimensions.xy);
  vec2 p = uv * 2.0 - 1.0;

  float u = p.x;
  float v = p.y;

  vec3 direction;

  // vulkan cubemap face order: +X, -X, +Y, -Y, +Z, -Z
  switch (pixel.z) {
  case 0:
    direction = vec3(1.0, -v, -u);
    break; // +X
  case 1:
    direction = vec3(-1.0, -v, u);
    break; // -X
  case 2:
    direction = vec3(u, 1.0, v);
    break; // +Y
  case 3:
    direction = vec3(u, -1.0, -v);
    break; // -Y
  case 4:
    direction = vec3(u, -v, 1.0);
    break; // +Z
  default:
    direction = vec3(-u, -v, -1.0);
  }

  direction = normalize(direction);

  float longitude = atan(direction.z, direction.x);
  float latitude = asin(clamp(direction.y, -1.0, 1.0));

  vec2 panoramaUV = vec2(longitude / (2.0 * PI) + 0.5, 0.5 - latitude / PI);

  vec4 color = texture(panorama, panoramaUV);

  imageStore(cubemapImage, pixel, color);
}